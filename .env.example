# Sentinel-2 land-cover classification · configuration of the whole stack.
#
# Copy it to .env (git-ignored) and set the real values there:
#   cp .env.example .env
#
# docker compose reads .env from the repository root (root docker-compose.yml
# and apps/airflow/compose.yml, which it includes). Every variable is required.
#
# Values with spaces or shell characters (&, *, ?) go in single quotes.
# Database passwords are embedded in connection URLs, so avoid @ : / ? # % in
# them. Database users and passwords are created when the postgres volume is
# first initialised; changing them later requires recreating that volume
# (docker compose down -v) or changing them inside Postgres.

# --- Project images (built locally from apps/*/Dockerfile) ---------------------
DOCKERHUB_USER=aristotekean
IMAGE_TAG=0.1.0

# --- PostgreSQL + PostGIS · one instance, three databases ----------------------
# Superuser; creates the three databases below on the first start.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Published host port; change it if the host already runs PostgreSQL.
POSTGRES_PORT=5432
# mlflow: MLflow backend store (experiments, runs, registry metadata)
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow
# airflow: Airflow metadata
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
# training: PostGIS database with the pixel samples and the class areas.
# Host and port as seen from inside the stack (not the published host port).
TRAIN_DB_HOST=postgres
TRAIN_DB_PORT=5432
TRAIN_DB_NAME=training
TRAIN_DB_USER=training
TRAIN_DB_PASSWORD=training

# --- MinIO ---------------------------------------------------------------------
# The same account is handed to S3 clients as AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# MLflow artifacts (models, metrics, plots).
MLFLOW_ARTIFACTS_BUCKET=mlflow
# Project data, with the prefixes bands/ polygons/ tsv/ predictions/.
DATA_BUCKET=sentinel2

# --- MLflow tracking server and registry ---------------------------------------
# Service names inside the stack.
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_EXPERIMENT_NAME=sentinel2-land-cover
# Extra allowed Host headers and CORS origins of the UI, comma separated. Needed
# to open the UI from another machine, e.g. 192.168.1.50:* and
# http://192.168.1.50:5001. Empty keeps localhost and the service name only.
MLFLOW_ALLOWED_HOSTS=
MLFLOW_CORS_ALLOWED_ORIGINS=
# Host port 5001: macOS AirPlay Receiver squats 5000.
MLFLOW_PORT=5001

# --- Registered model (written by Jupyter/Airflow, read by Streamlit/FastAPI) ---
MODEL_NAME=sentinel2-land-cover
MODEL_ALIAS=production
# Feature columns of the TSV, in order: the 10 Sentinel-2 bands of the scene.
BAND_NAMES=B01,B02,B03,B04,B05,B06,B07,B8A,B11,B12

# --- Jupyter (phase 1) ---------------------------------------------------------
JUPYTER_PORT=8888
# Login token: http://localhost:8888/?token=<JUPYTER_TOKEN>
JUPYTER_TOKEN=sentinel2

# --- Airflow ---------------------------------------
# Admin user of the UI, created on the first start.
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# Signs the tokens between the api-server and the task runners.
AIRFLOW_JWT_SECRET=change-me-jwt-secret
# Empty: connections and variables are stored unencrypted. Generate one with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Linux: set it to the output of `id -u` so Airflow can write the bind-mounted
# logs/ folder. macOS (Docker Desktop / OrbStack): leave 50000.
AIRFLOW_UID=50000
AIRFLOW_PORT=8080

# --- Streamlit -------------------------------------
STREAMLIT_PORT=8501

# --- FastAPI (optional, `api` profile) -----------------------------------------
API_PORT=8000